#!/bin/sh
#
# Rebuild editor.yymps before every push. This hook NEVER blocks the push: if
# the package cannot be rebuilt (no GameMaker, no PowerShell, export error) the
# push simply goes through with the previous package.
#
# See other/tools/pack_yymps.ps1 for the rebuild itself.
#
# Skip with:            POLYGON_SKIP_PACK=1 git push
# Bypass all hooks with: git push --no-verify

root=$(git rev-parse --show-toplevel) || exit 0
script="$root/other/tools/pack_yymps.ps1"

[ -z "$POLYGON_SKIP_PACK" ] || exit 0
[ -f "$script" ] || exit 0

if command -v pwsh >/dev/null 2>&1; then
  ps=pwsh
elif command -v powershell >/dev/null 2>&1; then
  ps=powershell
else
  echo "pre-push: PowerShell not found, editor.yymps not rebuilt" >&2
  exit 0
fi

"$ps" -NoProfile -ExecutionPolicy Bypass -File "$script"
code=$?

# pack_yymps.ps1: 0 = up to date, 2 = rewritten, 3 = skipped, 1 = error.
case "$code" in
  0|2)
    # The package on disk is fresh. Since pre-commit already rebuilds and
    # stages it, nothing more to do here. Just warn if it is somehow stale.
    if [ -n "$(git status --porcelain -- editor.yymps)" ]; then
      echo "pre-push: editor.yymps is stale; run 'git add editor.yymps' or commit again." >&2
    fi
    ;;
  3)
    echo "pre-push: rebuild of editor.yymps skipped (ProjectTool/PowerShell not available)." >&2
    ;;
  *)
    echo "pre-push: pack_yymps returned an error (exit $code), editor.yymps not updated." >&2
    ;;
esac

exit 0
